# Copy to .env and adjust. `.env` is gitignored — never commit real secrets.
# variables/environments.py reads these from the environment; command-line
# `--variable` values override them.

# Root URL of the application under test (required)
BASE_URL=https://www.saucedemo.com

# Browser SeleniumLibrary opens: chrome | firefox | headlesschrome (required)
BROWSER=chrome

# Environment name selecting the config block in the variable file (optional)
ENV=production

# Set to true to run the browser headless — used in CI (optional)
HEADLESS=false

# Standard test account — injected as a secret in CI (required)
TEST_USER=standard_user
TEST_PASSWORD=secret_sauce
